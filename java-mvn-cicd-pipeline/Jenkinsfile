pipeline {
    agent any

    tools {
        // Maven tool configured in Jenkins Global Tool Configuration (if configured)
        // maven 'Maven-3.9.x'
    }

    environment {
        APP_NAME = 'java-mvn-cicd-pipeline'
        DEPLOY_DIR_WINDOWS = 'C:\\jenkins-deployments'
        DEPLOY_DIR_LINUX = '/tmp'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code from Git repository...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Compiling Java source code with Maven...'
                script {
                    if (isUnix()) {
                        sh 'mvn clean compile'
                    } else {
                        bat 'mvn clean compile'
                    }
                }
            }
        }

        stage('Unit Test') {
            steps {
                echo 'Running JUnit test suite...'
                script {
                    if (isUnix()) {
                        sh 'mvn test'
                    } else {
                        bat 'mvn test'
                    }
                }
            }
            post {
                always {
                    echo 'Publishing JUnit test results...'
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging application into executable JAR (skipping redundant tests)...'
                script {
                    if (isUnix()) {
                        sh 'mvn package -DskipTests'
                    } else {
                        bat 'mvn package -DskipTests'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying artifact to staging destination...'
                script {
                    if (isUnix()) {
                        sh '''
                            mkdir -p /tmp
                            cp target/java-mvn-cicd-pipeline-1.0-SNAPSHOT.jar /tmp/deployed-app.jar
                            echo "Artifact successfully deployed to /tmp/deployed-app.jar"
                        '''
                    } else {
                        bat '''
                            if not exist C:\\jenkins-deployments mkdir C:\\jenkins-deployments
                            copy target\\java-mvn-cicd-pipeline-1.0-SNAPSHOT.jar C:\\jenkins-deployments\\deployed-app.jar
                            echo Artifact successfully deployed to C:\\jenkins-deployments\\deployed-app.jar
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo '=================================================='
            echo 'CI/CD Pipeline Build PASSED Successfully!'
            echo '=================================================='
        }
        failure {
            echo '=================================================='
            echo 'CI/CD Pipeline Build FAILED! Please check logs.'
            echo '=================================================='
        }
        always {
            echo 'Pipeline execution complete.'
        }
    }
}
