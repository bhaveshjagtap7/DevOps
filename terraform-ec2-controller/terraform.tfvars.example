# =============================================================================
# Terraform EC2 Controller - Variable Configurations Example
# Copy this file to terraform.tfvars and customize with your preferred values
# =============================================================================

# AWS Target Region
aws_region = "us-east-1"

# EC2 Sizing (Free tier eligible)
instance_type = "t3.micro"

# CIDR block allowed to connect via SSH
# In production, restrict this to your specific public IP (e.g. "203.0.113.25/32")
allowed_ssh_cidr = "0.0.0.0/0"

# Deployment Environment tag
environment = "development"